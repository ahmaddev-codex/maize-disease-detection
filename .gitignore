# ── Python ────────────────────────────────────────────────────────────────────
.venv/
__pycache__/
*.py[cod]
*.egg-info/
.eggs/

# ── Dataset — large files, download via Kaggle/PlantVillage ──────────────────
data/raw/plantvillage/
data/raw/synthetic/
data/raw/field_photos/

# ── Model weights — large binary files ───────────────────────────────────────
models/checkpoints/
models/exports/*.h5
models/exports/*.keras
models/exports/*.tflite

# Keep small exports (confusion matrix, heatmap summaries)
!models/exports/*.png
!models/exports/*.json

# ── TensorBoard / training logs ───────────────────────────────────────────────
logs/

# ── Mobile (Flutter) — see mobile/.gitignore for platform-specific rules ─────
mobile/build/
mobile/.dart_tool/
mobile/.flutter-plugins
mobile/.flutter-plugins-dependencies
mobile/pubspec.lock
mobile/android/.gradle/
mobile/android/local.properties
mobile/android/key.properties
mobile/ios/Pods/
mobile/ios/build/
mobile/ios/.symlinks/
mobile/ios/DerivedData/
mobile/ios/Podfile.lock
mobile/assets/models/*.tflite

# ── UAV / deployment ─────────────────────────────────────────────────────────
data/uav/patch_predictions.csv
data/uav/disease_heatmap.html

# ── Environment / secrets ─────────────────────────────────────────────────────
.env
.env.*
!.env.example

# ── IDE ───────────────────────────────────────────────────────────────────────
.idea/
.vscode/
.claude/

# ── macOS ─────────────────────────────────────────────────────────────────────
.DS_Store

# ── Jupyter ───────────────────────────────────────────────────────────────────
.ipynb_checkpoints/
