platform :osx, '13.0'

# CocoaPods analytics sends network stats synchronously affecting flutter build latency.
ENV['COCOAPODS_DISABLE_STATS'] = 'true'

project 'Runner', {
  'Debug' => :debug,
  'Profile' => :release,
  'Release' => :release,
}

def flutter_root
  generated_xcode_build_settings_path = File.expand_path(File.join('..', 'Flutter', 'ephemeral', 'Flutter-Generated.xcconfig'), __FILE__)
  unless File.exist?(generated_xcode_build_settings_path)
    raise "#{generated_xcode_build_settings_path} must exist. If you're running pod install manually, make sure \"flutter pub get\" is executed first"
  end

  File.foreach(generated_xcode_build_settings_path) do |line|
    matches = line.match(/FLUTTER_ROOT\=(.*)/)
    return matches[1].strip if matches
  end
  raise "FLUTTER_ROOT not found in #{generated_xcode_build_settings_path}. Try deleting Flutter-Generated.xcconfig, then run \"flutter pub get\""
end

require File.expand_path(File.join('packages', 'flutter_tools', 'bin', 'podhelper'), flutter_root)

flutter_macos_podfile_setup

target 'Runner' do
  use_frameworks!

  flutter_install_all_macos_pods File.dirname(File.realpath(__FILE__))
  target 'RunnerTests' do
    inherit! :search_paths
  end
end

post_install do |installer|
  installer.pods_project.targets.each do |target|
    flutter_additional_macos_build_settings(target)
  end

  # tflite_flutter 0.12.1: vendored_libraries does not auto-embed .dylib into
  # Contents/Frameworks/. Add a Run Script phase to the Runner target that
  # copies libtensorflowlite_c.dylib there so dyld can find it at @rpath.
  installer.aggregate_targets.each do |agg_target|
    next unless agg_target.name.include?('Runner')
    agg_target.user_project.targets.each do |native_target|
      next unless native_target.name == 'Runner'

      # Avoid duplicating the phase on repeated pod install runs.
      next if native_target.shell_script_build_phases.any? { |p|
        p.name == '[TFLite] Embed libtensorflowlite_c.dylib'
      }

      phase = native_target.new_shell_script_build_phase('[TFLite] Embed libtensorflowlite_c.dylib')
      phase.shell_script = <<~BASH
        DYLIB_SRC="$HOME/.pub-cache/hosted/pub.dev/tflite_flutter-0.12.1/macos/libtensorflowlite_c.dylib"
        # 1) Contents/Frameworks/ — required by tflite_flutter.framework @rpath at native load time
        FRAMEWORKS_DIR="${BUILT_PRODUCTS_DIR}/${CONTENTS_FOLDER_PATH}/Frameworks"
        mkdir -p "$FRAMEWORKS_DIR"
        cp -f "$DYLIB_SRC" "$FRAMEWORKS_DIR/libtensorflowlite_c.dylib"
        codesign --force --sign "${EXPANDED_CODE_SIGN_IDENTITY:-}" "$FRAMEWORKS_DIR/libtensorflowlite_c.dylib" 2>/dev/null || true
        # 2) Contents/resources/ — required by Dart FFI DynamicLibrary.open() in bindings.dart
        RESOURCES_DIR="${BUILT_PRODUCTS_DIR}/${CONTENTS_FOLDER_PATH}/resources"
        mkdir -p "$RESOURCES_DIR"
        cp -f "$DYLIB_SRC" "$RESOURCES_DIR/libtensorflowlite_c-mac.dylib"
        codesign --force --sign "${EXPANDED_CODE_SIGN_IDENTITY:-}" "$RESOURCES_DIR/libtensorflowlite_c-mac.dylib" 2>/dev/null || true
      BASH
      agg_target.user_project.save
    end
  end
end
