<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Camera — required by react-native-vision-camera -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-feature android:name="android.hardware.camera" android:required="false" />
    <uses-feature android:name="android.hardware.camera.autofocus" android:required="false" />

    <!-- Location — GPS tagging of scan records -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />

    <!-- Storage — reading from gallery (API ≤32) -->
    <uses-permission
        android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />
    <!-- API 33+ granular media permission -->
    <uses-permission android:name="android.permission.READ_MEDIA_IMAGES" />

    <!-- Internet — Gemini AI API calls (optional, offline fallback exists) -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- Vibrate — haptic feedback on capture -->
    <uses-permission android:name="android.permission.VIBRATE" />

    <application
        android:name=".MainApplication"
        android:label="MaizeGuard"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:allowBackup="false"
        android:usesCleartextTraffic="false"
        android:hardwareAccelerated="true"
        android:largeHeap="true">

        <!--
          largeHeap="true" is important: TFLite model (13MB) + Skia surface
          (300×300×4 = 360KB) + Vision Camera buffers can spike heap on
          low-RAM devices. This doubles the available heap on most OEMs.
        -->

        <activity
            android:name=".MainActivity"
            android:label="MaizeGuard"
            android:configChanges="keyboard|keyboardHidden|orientation|screenLayout|screenSize|smallestScreenSize|uiMode"
            android:launchMode="singleTask"
            android:windowSoftInputMode="adjustResize"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
